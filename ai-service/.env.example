# SocialConnect AI Recommendation Microservice Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8001
HOST=0.0.0.0

# Security / Access Control (Only accessible from main backend)
BACKEND_INTERNAL_API_KEY=dev_internal_ai_service_key_32chars_min
ALLOWED_HOSTS=["127.0.0.1","localhost"]

# Heuristic Algorithm Configuration
ALGORITHM_VERSION=v1.0-heuristic
WEIGHT_INTEREST=0.40
WEIGHT_SCHEDULE=0.30
WEIGHT_LOCATION=0.20
WEIGHT_CATEGORY=0.10
MIN_THRESHOLD_EXPLANATION=0.45

